{
  "name": "milc-skin-analysis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace backend",
    "dev:client": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
